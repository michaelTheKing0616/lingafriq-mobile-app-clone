    {
      "id": "sw.pat.present-na",
      "description_l1": "Infix -na- marks present progressive or habitual action on the verb stem",
      "form": "Subject prefix + -na- + verb stem",
      "examples": [
        "Ninaenda shuleni",
        "Anasoma kitabu",
        "Wanakula chakula"
      ],
      "contrasts": [
        "Nilienda shuleni (past)",
        "Nitaenda shuleni (future)",
        "Nimeenda shuleni (already gone)"
      ],
      "common_errors": [
        "Omitting -na- and using the bare stem for ongoing actions",
        "Confusing present -na- with perfect -me- after the subject prefix"
      ],
      "cefr": "A1",
