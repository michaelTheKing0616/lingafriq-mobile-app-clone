    {
      "id": "sw.pat.perfect-me",
      "description_l1": "Infix -me- marks the perfect: an action completed with present relevance",
      "form": "Subject prefix + -me- + verb stem",
      "examples": [
        "Nimefika",
        "Amekula",
        "Tumemaliza kazi"
      ],
      "contrasts": [
        "Nilifika jana (past narrative, -li-)",
        "Ninafika (still arriving, -na-)",
        "Nitafika kesho (future, -ta-)"
      ],
      "common_errors": [
        "Using -me- for distant past narratives better expressed with -li-",
        "Confusing perfect -me- with English simple past without present relevance"
      ],
