      "id": "sw.pat.past-li",
      "description_l1": "Infix -li- marks a completed action in the past tense",
      "form": "Subject prefix + -li- + verb stem",
      "examples": [
        "Nilienda sokoni",
        "Alisoma gazeti",
        "Tulikula jioni"
      ],
      "contrasts": [
        "Ninaenda sokoni (present)",
        "Nitaenda sokoni (future)",
        "Nimeenda sokoni (perfect, result still relevant)"
      ],
      "common_errors": [
        "Using -li- for future events instead of -ta-",
        "Dropping -li- and relying only on a time adverb for past reference"
      ],
