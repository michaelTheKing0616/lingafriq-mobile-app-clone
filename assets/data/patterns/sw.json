    {
      "id": "sw.pat.future-ta",
      "description_l1": "Infix -ta- marks a future or intended action",
      "form": "Subject prefix + -ta- + verb stem",
      "examples": [
        "Nitaenda kesho",
        "Atakuja baadaye",
        "Tutasoma kesho asubuhi"
      ],
      "contrasts": [
        "Ninaenda kesho (present progressive, not strictly future)",
        "Nilienda jana (past)",
        "Nimeenda tayari (already done)"
      ],
      "common_errors": [
        "Using -na- alone with kesho instead of -ta- for a definite future plan",
        "Placing time words without the -ta- infix when future reference is required"
      ],
