    {
      "id": "ha.pat.copula-ne",
      "description_l1": "Copula ne (masculine/common) and ce (feminine) link a subject to a predicate noun",
      "form": "Subject + predicate noun + ne/ce",
      "examples": [
        "Wannan littafi ne",
        "Ita malama ce",
        "Sunan sa Musa ne"
      ],
      "contrasts": [
        "Wannan littafi (incomplete without copula in equative clauses)",
        "Yana da littafi (possession with da, not identity)"
      ],
      "common_errors": [
        "Omitting ne/ce in equative sentences",
        "Using ne where ce is required for feminine subjects"
      ],
