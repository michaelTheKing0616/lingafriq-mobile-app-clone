    {
      "id": "ha.pat.continuous-ina",
      "description_l1": "Auxiliary ina (and its subject forms) marks progressive or continuous action",
      "form": "Subject ina + verbal noun / complement",
      "examples": [
        "Ina karatu",
        "Yana aiki",
        "Muna tafiya"
      ],
      "contrasts": [
        "Na karatu (completed reading)",
        "Zan karatu (future reading)"
      ],
      "common_errors": [
        "Using ina for a single completed event instead of the perfective",
        "Mismatching the subject form of ina with the grammatical subject"
      ],
