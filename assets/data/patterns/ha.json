    {
      "id": "ha.pat.future-za",
      "description_l1": "Future marker za (and subject agreement forms) before the infinitive marks upcoming action",
      "form": "Subject za + infinitive",
      "examples": [
        "Zan tafi",
        "Za ta zo gobe",
        "Za mu ci abinci"
      ],
      "contrasts": [
        "Na tafi (past departure)",
        "Ina tafiya (ongoing travel)"
      ],
      "common_errors": [
        "Using za for past events",
        "Wrong subject agreement form on za"
      ],
