    {
      "id": "ig.pat.locative-no",
      "description_l1": "Copular nọ (and related forms) with location phrase marks where someone or something is",
      "form": "Subject + nọ + n' + location",
      "examples": [
        "O nọ n'ụlọ",
        "Anyị nọ n'ụlọ akwụkwọ",
        "Ha nọ n'ahịa"
      ],
      "contrasts": [
        "O ga-abịa n'ụlọ (future motion, not location)",
        "O bịara n'ụlọ (completed motion)"
      ],
      "common_errors": [
        "Omitting nọ before a location phrase",
        "Using bare n' without the copular verb for static location"
      ],
