    {
      "id": "ig.pat.future-ga",
      "description_l1": "Prefix ga- on the verb stem marks a future or intended action",
      "form": "Subject + ga- + verb stem",
      "examples": [
        "O ga-abịa",
        "Anyị ga-aga ụlọ",
        "Ha ga-eri nri"
      ],
      "contrasts": [
        "O na-abịa (in progress)",
        "O bịara (past arrival)"
      ],
      "common_errors": [
        "Using ga- for completed events instead of the perfective stem",
        "Dropping ga- and relying only on a time adverb for future reference"
      ],
