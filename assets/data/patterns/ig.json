    {
      "id": "ig.pat.progressive-na",
      "description_l1": "Prefix na- on the verb stem marks an action in progress (progressive aspect)",
      "form": "Subject + na- + verb stem",
      "examples": [
        "O na-agụ akwụkwọ",
        "Anyị na-egwuru egwu",
        "Ha na-eri nri"
      ],
      "contrasts": [
        "O ga-agụ akwụkwọ (future)",
        "O gụrụ akwụkwọ (completed)"
      ],
      "common_errors": [
        "Omitting na- and using only the bare verb for ongoing actions",
        "Placing na- after the verb stem instead of before it"
      ],
      "cefr": "A1",
