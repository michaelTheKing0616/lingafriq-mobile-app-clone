    {
      "id": "pcm.pat.progressive-de",
      "description_l1": "Marker de before the verb shows an action in progress (progressive)",
      "form": "Subject + de + verb (+ complement)",
      "examples": [
        "I de chop",
        "Dem dey waka",
        "She de cook for kitchen"
      ],
      "contrasts": [
        "I don chop (already done)",
        "I go chop (future intention)"
      ],
      "common_errors": [
        "Using bare English present without de for ongoing Pidgin actions",
        "Writing dey as standard English they"
      ],
