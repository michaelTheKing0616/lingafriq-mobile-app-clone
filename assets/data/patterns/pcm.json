    {
      "id": "pcm.pat.perfect-don",
      "description_l1": "Marker don before the verb marks a completed action (perfect)",
      "form": "Subject + don + verb (+ complement)",
      "examples": [
        "I don finish work",
        "E don reach house",
        "We don see am"
      ],
      "contrasts": [
        "I de work (still working)",
        "I go finish am (future completion)"
      ],
      "common_errors": [
        "Using English done alone without don in Pidgin clauses",
        "Placing don after the verb like English perfect auxiliaries"
      ],
