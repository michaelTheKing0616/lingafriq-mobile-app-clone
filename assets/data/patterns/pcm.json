    {
      "id": "pcm.pat.future-go",
      "description_l1": "Marker go before the verb marks future intention",
      "form": "Subject + go + verb (+ complement)",
      "examples": [
        "I go come tomorrow",
        "Dem go start now",
        "She go tell you"
      ],
      "contrasts": [
        "I de come (on the way now)",
        "I don come (already arrived)"
      ],
      "common_errors": [
        "Using will instead of go in Pidgin future clauses",
        "Omitting go and copying English going to without Pidgin grammar"
      ],
