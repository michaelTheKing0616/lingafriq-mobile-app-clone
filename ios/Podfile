# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  # flutter_vibrate 1.3.0 uses TARGET_OS_SIMULATOR as a Swift expression (line: `private let isDevice = TARGET_OS_SIMULATOR == 0`).
  # Newer Swift/Xcode no longer exposes that C macro in Swift source, so compile fails. Patch all known locations.
  patch_flutter_vibrate = lambda do |ios_root|
    pub_cache = ENV['PUB_CACHE'] || File.join(Dir.home, '.pub-cache')
    globs = [
      "#{pub_cache}/hosted/pub.dev/flutter_vibrate-*/ios/Classes/*.swift",
      File.join(ios_root, '.symlinks', 'plugins', 'flutter_vibrate', 'ios', 'Classes', '*.swift'),
      File.join(ios_root, 'Flutter', 'ephemeral', '.plugin_symlinks', 'flutter_vibrate', 'ios', 'Classes', '*.swift'),
    ]
    seen = {}
    globs.each do |pattern|
      Dir.glob(pattern).each do |swift_file|
        next if seen[swift_file]
        seen[swift_file] = true
        next unless File.file?(swift_file)

        content = File.read(swift_file)
        next unless content.include?('TARGET_OS_SIMULATOR')

        original = content.dup
        content.gsub!('#if TARGET_OS_SIMULATOR', '#if targetEnvironment(simulator)')
        content.gsub!('#if !TARGET_OS_SIMULATOR', '#if !targetEnvironment(simulator)')
        content.gsub!(
          /private let isDevice = TARGET_OS_SIMULATOR == 0/,
          <<~SWIFT.strip
            #if targetEnvironment(simulator)
            private let isDevice = false
            #else
            private let isDevice = true
            #endif
          SWIFT
        )
        next if content == original

        File.write(swift_file, content)
        Pod::UI.puts "Patched flutter_vibrate: #{swift_file}"
      end
    end
  end
  patch_flutter_vibrate.call(File.dirname(File.realpath(__FILE__)))

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['DEVELOPMENT_TEAM'] = 'Z5YSG5V5DV'
      # Set minimum iOS deployment target to 16.0 (google_mlkit_commons requires ≥15.5; 16.0 for headroom)
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
end
