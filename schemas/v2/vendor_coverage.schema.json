{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingafriq.com/v2/vendor_coverage.schema.json",
  "title": "LingAfriq Stage 1 vendor coverage",
  "description": "Planned ASR/TTS/realtime vendors and readiness level targets (ELEVATION §6.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["charter", "card_id", "sources", "level_targets", "languages"],
  "properties": {
    "charter": { "type": "string", "const": "v2" },
    "card_id": { "type": "string", "const": "P4-113" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "level_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_start", "l1_due_quarters", "l2_due_quarters"],
      "properties": {
        "program_start": {
          "type": "string",
          "format": "date",
          "description": "ISO-8601 date; L1/L2 due dates are computed from this anchor."
        },
        "l1_due_quarters": { "type": "integer", "minimum": 1, "maximum": 4 },
        "l2_due_quarters": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/language_coverage" }
    }
  },
  "$defs": {
    "vendor_ref": {
      "type": "string",
      "enum": [
        "intron",
        "azure",
        "gemini_live",
        "cascade",
        "inhouse",
        "custom_voice_required"
      ]
    },
    "eval_status": {
      "type": "string",
      "enum": ["not_run", "pass", "fail"]
    },
    "language_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language_id",
        "asr",
        "dynamic_tts",
        "realtime_voice",
        "tone_scoring",
        "stage_evals"
      ],
      "properties": {
        "language_id": { "type": "string", "minLength": 2 },
        "asr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "code_switching"],
          "properties": {
            "vendor": { "const": "intron" },
            "code_switching": { "type": "boolean" }
          }
        },
        "dynamic_tts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "enabled"],
          "properties": {
            "vendor": {
              "type": "string",
              "enum": ["intron", "azure", "custom_voice_required"]
            },
            "enabled": { "type": "boolean" },
            "disabled_reason": { "type": "string", "minLength": 1 }
          }
        },
        "realtime_voice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["gemini_live", "cascade"] }
          }
        },
        "tone_scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor"],
          "properties": {
            "vendor": { "const": "inhouse" }
          }
        },
        "stage_evals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["realtime_voice", "persona"],
          "properties": {
            "realtime_voice": { "$ref": "#/$defs/eval_status" },
            "persona": { "$ref": "#/$defs/eval_status" }
          }
        }
      }
    }
  }
}
