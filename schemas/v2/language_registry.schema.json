{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingafriq.com/v2/language_registry.schema.json",
  "title": "LingAfriq Language Registry",
  "description": "Waves, scripts, readiness and consent flags per language entry (ELEVATION §6.4, P4-112).",
  "type": "object",
  "additionalProperties": false,
  "required": ["card_id", "planning_targets", "entries"],
  "properties": {
    "card_id": { "const": "P4-112" },
    "sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "planning_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave_1", "wave_2_cumulative", "wave_3_cumulative", "wave_4_cumulative", "disclaimer"],
      "properties": {
        "wave_1": { "type": "integer", "const": 7 },
        "wave_2_cumulative": { "type": "string", "const": "~21" },
        "wave_3_cumulative": { "type": "string", "const": "~46" },
        "wave_4_cumulative": { "type": "string", "const": "95+" },
        "disclaimer": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry_entry" }
    }
  },
  "$defs": {
    "registry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "language_id", "name", "wave", "script", "readiness_level"],
      "properties": {
        "entry_id": { "type": "string", "minLength": 2 },
        "language_id": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 1 },
        "wave": { "type": "integer", "minimum": 1, "maximum": 4 },
        "script": { "type": "string", "minLength": 4, "maxLength": 4 },
        "readiness_level": {
          "type": ["string", "null"],
          "enum": ["L0", "L1", "L2", "L3", null]
        },
        "community_consent_required": { "type": "boolean" },
        "consent": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["recorded", "benefit_sharing_terms"],
          "properties": {
            "recorded": { "type": "boolean" },
            "benefit_sharing_terms": { "type": "boolean" },
            "recorded_on": { "type": "string", "format": "date" }
          }
        }
      }
    }
  }
}
