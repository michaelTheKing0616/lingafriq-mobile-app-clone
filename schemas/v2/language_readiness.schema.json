{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingafriq.com/v2/language_readiness.schema.json",
  "title": "LingAfriq Language Readiness Manifest",
  "description": "Per-language inventory, coverage, feature flags and eval status for L0–L3 promotion gates (ELEVATION §6.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "readiness_level", "inventory", "coverage", "features", "items"],
  "properties": {
    "language": { "type": "string", "minLength": 2 },
    "readiness_level": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3"]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_count", "culture_card_count", "recorded_voice_ids"],
      "properties": {
        "has_greetings": { "type": "boolean" },
        "has_numbers": { "type": "boolean" },
        "word_count": { "type": "integer", "minimum": 0 },
        "culture_card_count": { "type": "integer", "minimum": 0 },
        "recorded_voice_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "A1": { "type": "string", "enum": ["complete", "in_progress", "missing"] },
        "A2": { "type": "string", "enum": ["complete", "in_progress", "missing"] },
        "B1": { "type": "string", "enum": ["complete", "in_progress", "missing"] }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asr_understood_feedback": { "type": "boolean" },
        "tone_scoring": { "type": "boolean" },
        "pronunciation_scoring": { "type": "boolean" },
        "dynamic_tts": { "type": "boolean" },
        "ai_tutor_modes": { "type": "boolean" },
        "realtime_voice": { "type": "boolean" },
        "personas": { "type": "boolean" },
        "credential_checkpoints": { "type": "boolean" }
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "realtime_voice": { "type": "string", "enum": ["pass", "fail", "pending", "not_required"] },
        "persona": { "type": "string", "enum": ["pass", "fail", "pending", "not_required"] }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/content_item" }
    }
  },
  "$defs": {
    "content_item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "audio"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": {
          "type": "string",
          "enum": ["beta", "expert_reviewed", "native_verified"]
        },
        "audio": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/audio_entry" }
        },
        "review": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "reviewers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["reviewer_id", "role", "approved"],
                "properties": {
                  "reviewer_id": { "type": "string" },
                  "role": { "type": "string", "enum": ["native", "linguist"] },
                  "approved": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "audio_entry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "uri"],
      "properties": {
        "kind": { "type": "string", "enum": ["human", "tts_synthetic"] },
        "uri": { "type": "string", "minLength": 1 },
        "synthetic_voice_tag": { "type": "string" }
      }
    }
  }
}
