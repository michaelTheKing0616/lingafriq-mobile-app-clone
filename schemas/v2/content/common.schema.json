{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingafriq.com/v2/content/common.schema.json",
  "title": "LingAfriq shared content envelope",
  "description": "Provenance, claims, label, audio kind, and AI flags shared by pipeline content objects (P4-100).",
  "type": "object",
  "additionalProperties": true,
  "required": ["label", "provenance", "claims", "confidence", "risk_tags", "audio"],
  "properties": {
    "label": {
      "type": "string",
      "enum": ["beta", "expert_reviewed", "native_verified"]
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_tags": {
      "type": "array",
      "items": { "$ref": "#/$defs/riskTag" },
      "uniqueItems": true
    },
    "audio": {
      "type": "array",
      "items": { "$ref": "#/$defs/audioRef" }
    },
    "review": { "$ref": "#/$defs/review" },
    "form_kind": {
      "type": "string",
      "enum": ["standard", "regional"],
      "default": "standard"
    },
    "dialect_tag": {
      "type": "string",
      "pattern": "^(standard|[a-z0-9_-]{2,64})$"
    },
    "region": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sources", "author", "created_at", "ai_assisted"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "ai_assisted": { "type": "boolean" },
        "model_id": { "type": "string", "minLength": 1 },
        "prompt_id": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenanceSource" }
        }
      }
    },
    "provenanceSource": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "licence", "uri_or_citation", "retrieved_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "licence": { "type": "string", "minLength": 1 },
        "uri_or_citation": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "minLength": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "source_ref"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["tone", "cultural", "linguistic", "factual"]
        },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "riskTag": {
      "type": "string",
      "enum": [
        "tone",
        "idiom",
        "proverb",
        "culture_history_religion",
        "honorific",
        "grammar_explanation",
        "child_audience",
        "anglicised_pidgin"
      ]
    },
    "audioRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["human", "tts_synthetic"] },
        "uri": { "type": "string" },
        "synthetic_voice_tag": { "type": "string" },
        "take_kind": {
          "type": "string",
          "enum": ["standard", "regional"],
          "default": "standard"
        },
        "dialect_tag": {
          "type": "string",
          "pattern": "^(standard|[a-z0-9_-]{2,64})$"
        },
        "region": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reviewers": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewer" }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["role", "reviewer_id", "approved"],
      "properties": {
        "role": { "type": "string", "enum": ["native", "linguist", "reviewer"] },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "approved": { "type": "boolean" }
      }
    }
  }
}
