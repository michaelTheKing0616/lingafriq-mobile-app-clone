{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingafriq.com/v2/content/item.schema.json",
  "title": "LingAfriq exercise item (v2)",
  "description": "Exercise item with answer matching rules, distractors, IRT and skill tags (P4-103).",
  "allOf": [
    { "$ref": "common.schema.json" },
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "stimulus", "answer_spec", "skill_tags", "irt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z]{2,3}\\.item\\.[a-z0-9._-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "listen_and_choose",
            "tone_identification",
            "picture_matching",
            "dictation",
            "sentence_building",
            "speaking_prompt",
            "short_conversation",
            "multiple_choice"
          ]
        },
        "stimulus": { "$ref": "#/$defs/stimulus" },
        "answer_spec": { "$ref": "#/$defs/answerSpec" },
        "distractors": {
          "type": "array",
          "items": { "$ref": "#/$defs/distractor" }
        },
        "skill_tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,80}$"
          }
        },
        "irt": { "$ref": "#/$defs/irt" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "multiple_choice" } },
            "required": ["type"]
          },
          "then": {
            "required": ["distractors"],
            "properties": {
              "distractors": { "minItems": 1 }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "stimulus": {
      "type": "object",
      "additionalProperties": true,
      "required": ["refs"],
      "properties": {
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "answerSpec": {
      "type": "object",
      "additionalProperties": true,
      "required": ["correct", "accepted_variants", "diacritic_matching"],
      "properties": {
        "correct": { "type": "string", "minLength": 1 },
        "accepted_variants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "diacritic_matching": {
          "type": "string",
          "enum": ["strict", "tone_lenient", "diacritic_insensitive"]
        }
      }
    },
    "distractor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text", "rationale"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "irt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["irt_status", "a", "b"],
          "properties": {
            "irt_status": { "const": "calibrated" },
            "a": { "type": "number", "exclusiveMinimum": 0 },
            "b": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["irt_status"],
          "properties": {
            "irt_status": { "const": "uncalibrated" }
          }
        }
      ]
    }
  }
}
