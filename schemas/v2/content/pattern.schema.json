{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingafriq.com/v2/content/pattern.schema.json",
  "title": "LingAfriq grammar pattern (v2)",
  "description": "Grammar pattern with examples and contrasts (P4-102).",
  "allOf": [
    { "$ref": "common.schema.json" },
    {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "description_l1",
        "form",
        "examples",
        "contrasts",
        "common_errors",
        "cefr"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z]{2,3}\\.pat\\.[a-z0-9]+$"
        },
        "description_l1": { "type": "string", "minLength": 1 },
        "form": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "contrasts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "common_errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cefr": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        }
      }
    }
  ]
}
